--With Partition by Year

SELECT
order_date,
total_sales,
SUM(total_sales) OVER (partition BY YEAR(order_date) ORDER BY order_date ) AS running_total_sales,
AVG(avg_price) OVER (partition BY YEAR(order_date) ORDER BY order_date ) AS moving_avg_price
FROM
(
SELECT
DATETRUNC(MONTH,order_date) AS order_date,
SUM(sales_amount) AS total_sales,
AVG(price) AS avg_price
FROM gold.fact_sales
where order_date IS NOT NULL
GROUP BY DATETRUNC(MONTH,order_date)
) AS monthly_sales

-- 3 months moving average

SELECT
order_date,
total_sales,
SUM(total_sales) OVER (partition BY YEAR(order_date) ORDER BY order_date ) AS running_total_sales,
AVG(avg_price) OVER (partition BY YEAR(order_date) ORDER BY order_date ROWS BETWEEN 2 PRECEDING AND CURRENT ROW ) AS moving_avg_price
FROM
(
SELECT
DATETRUNC(MONTH,order_date) AS order_date,
SUM(sales_amount) AS total_sales,
AVG(price) AS avg_price
FROM gold.fact_sales
where order_date IS NOT NULL
GROUP BY DATETRUNC(MONTH,order_date)
) AS monthly_sales

-- Performance Analysis

-- Analyze the yearly performance of products by compparing each product's sales to both its average performance and previous year sales

SELECT
f.order_date,
p.product_name,
f.sales_amount
from gold.fact_sales f
JOIN gold.dim_products p on f.product_key = p.product_key;

WITH Yearly_product_sales AS (
SELECT
year(f.order_date) AS order_year,
p.product_name,
SUM(f.sales_amount) as total_sales
FROM gold.fact_sales f
JOIN gold.dim_products p on f.product_key = p.product_key
where f.order_date IS NOT NULL
GROUP BY year(f.order_date), p.product_name
)
SELECT
order_year,
product_name,
total_sales,
AVG(total_sales)  OVER (PARTITION BY product_name) AS avg_product_sales,
total_sales - AVG(total_sales)  OVER (PARTITION BY product_name) AS sales_vs_avg,
CASE WHEN total_sales - AVG(total_sales)  OVER (PARTITION BY product_name) > 0 THEN 'Above Average' 
     WHEN total_sales - AVG(total_sales)  OVER (PARTITION BY product_name) < 0 THEN 'Below Average'
     ELSE 'Average' END performance_vs_avg
FROM Yearly_product_sales;

-- Comparing to Previous Year 
-- year over year comparison (Simmilarly you can do month over month or quarter over quarter)


WITH Yearly_product_sales AS (
SELECT
year(f.order_date) AS order_year,
p.product_name,
SUM(f.sales_amount) as total_sales
FROM gold.fact_sales f
JOIN gold.dim_products p on f.product_key = p.product_key
where f.order_date IS NOT NULL
GROUP BY year(f.order_date), p.product_name
)
SELECT
order_year,
product_name,
total_sales,
AVG(total_sales)  OVER (PARTITION BY product_name) AS avg_product_sales,
total_sales - AVG(total_sales)  OVER (PARTITION BY product_name) AS sales_vs_avg,
CASE WHEN total_sales - AVG(total_sales)  OVER (PARTITION BY product_name) > 0 THEN 'Above Average' 
     WHEN total_sales - AVG(total_sales)  OVER (PARTITION BY product_name) < 0 THEN 'Below Average'
     ELSE 'Average' END performance_vs_avg,
LAG(total_sales) OVER (PARTITION BY product_name ORDER BY order_year) AS previous_year_sales,
total_sales - LAG(total_sales) OVER (PARTITION BY product_name ORDER BY order_year) AS sales_vs_previous_year,
CASE WHEN total_sales - LAG(total_sales) OVER (PARTITION BY product_name ORDER BY order_year) > 0 THEN 'Improved' 
     WHEN total_sales - LAG(total_sales) OVER (PARTITION BY product_name ORDER BY order_year) < 0 THEN 'Declined'
     ELSE 'No Change' END performance_vs_previous_year
FROM Yearly_product_sales;

-- Part to Whole (Proportion) Analysis
-- What proportion of total sales does each product category contribute to overall sales

WITH category_sales AS (
SELECT
p.category,
SUM(f.sales_amount) AS cat_sales
from gold.fact_sales f
JOIN gold.dim_products p on f.product_key = p.product_key
GROUP BY p.category
)
SELECT
category,
cat_sales,
SUM(cat_sales) OVER () AS total_sales,
CONCAT(ROUND(CAST(cat_sales AS FLOAT) / SUM(cat_sales) OVER () * 100, 2), '%') AS sales_proportion
FROM category_sales;

