-- Running total of Sales Over Time

/* This is the default setup and when we are not partitioning the data year 
over year or month over month it will give us cumulative sales from the 
begining of time*/
/* ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW is optional 
here as its the default behavior*/

SELECT
order_date,
total_sales,
SUM(total_sales) OVER (ORDER BY order_date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running_total_sales
FROM
(
SELECT
DATETRUNC(MONTH,order_date) AS order_date,   
SUM(sales_amount) AS total_sales,
SUM(quantity) AS total_quantity
FROM gold.fact_sales
where order_date IS NOT NULL
GROUP BY DATETRUNC(MONTH,order_date)
) AS monthly_sales


